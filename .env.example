# New Relic API credentials
# Create a User API key (starts with NRAK-) at https://one.newrelic.com/api-keys
NEW_RELIC_API_KEY=

# Numeric account ID that NRQL queries should run against (shown in the same API keys page)
NEW_RELIC_ACCOUNT_ID=

# US or EU depending on which New Relic data center your account lives in
NEW_RELIC_REGION=US
